{
  "name": "acyka-api",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "generate": "bun run tools/generate.ts",
    "check": "bun run --filter '*' check",
    "test": "bun test",
    "docs": "bun --cwd apps/docs run dev",
    "docs:check": "bun --cwd apps/docs run check",
    "docs:build": "bun --cwd apps/docs run build"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
